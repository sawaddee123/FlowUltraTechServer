# Port for captcha service
PORT=8001

# JWT token for authentication (shared with auth-service)
JWT_TOKEN=your-secret-jwt-token-here

# Node environment
NODE_ENV=development

# Trust proxy (for rate limiting by IP)
TRUST_PROXY=1

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/tiktok_sandbox

# System Root Configuration
ROOT_USERNAME=root
ROOT_PASSWORD=root123456
ROOT_EMAIL=root@system.local
